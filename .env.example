# =============================================================
# Worksoft Mini Task Tracker — .env.example
#
# Bu dosya GIT'e commit edilir.
# Gerçek değerleri içeren .env dosyası ASLA commit edilmez.
#
# Kullanım:
#   cp .env.example .env
#   .env içindeki değerleri doldurun
# =============================================================

# ---------------------------
# MSSQL
# ---------------------------
MSSQL_SA_PASSWORD=YourStrong@Password123          # En az 8 karakter, büyük/küçük/rakam/özel
MSSQL_PID=Developer                               # Developer | Express | Standard | Enterprise
DB_NAME=WorksoftTaskTracker

# ---------------------------
# ASP.NET CORE — BACKEND
# ---------------------------
ASPNETCORE_ENVIRONMENT=Development                # Development | Staging | Production
ASPNETCORE_URLS=http://+:8080

# Connection string (docker-compose içinde service adı kullanılır)
CONNECTION_STRING=Server=mssql,1433;Database=${DB_NAME};User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;

# JWT
JWT_SECRET_KEY=CHANGE_ME_minimum_32_character_random_string_here
JWT_ISSUER=WorksoftTaskTracker
JWT_AUDIENCE=WorksoftTaskTrackerClient
JWT_EXPIRE_MINUTES=60

# ---------------------------
# REDIS
# ---------------------------
REDIS_CONNECTION_STRING=redis:6379                # docker-compose service adı
REDIS_INSTANCE_NAME=WorksoftCache
REDIS_DASHBOARD_CACHE_SECONDS=300                 # Dashboard özet verisi TTL (5 dk)
REDIS_ANNOUNCEMENT_CACHE_SECONDS=600              # Duyuru listesi TTL (10 dk)

# ---------------------------
# REACT — FRONTEND
# ---------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE=Worksoft Task Tracker

# ---------------------------
# EMAIL (duyuru bildirimleri için — opsiyonel)
# ---------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@worksoft.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=Worksoft Task Tracker

# ---------------------------
# SWAGGER (production'da kapalı tutulmalı)
# ---------------------------
ENABLE_SWAGGER=true                               # Production'da false yapın
